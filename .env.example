# Copie para .env e preencha só o que for usar. O .env nunca vai para o git.

# Chave da Anthropic. Vazia, o atendente usa só o motor de regras (custo zero).
ANTHROPIC_API_KEY=
# Com a chave, o Claude só é consultado quando as regras têm dúvida. Modelo e effort (low, medium, high, xhigh, max).
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# Liga o webhook da WhatsApp Cloud API. Desligado, as rotas /webhook/whatsapp nem existem.
WHATSAPP_ENABLED=false
# Token que você inventa e cadastra no painel da Meta, com pelo menos 32 caracteres. Gere um com: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=
# App Secret do app na Meta (App Settings > Basic); assina os webhooks.
WHATSAPP_APP_SECRET=
# Phone Number ID do número que recebe as mensagens (WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=

# Liga o envio das respostas pela Graph API. Desligado, as respostas só aparecem no log, mascaradas.
WHATSAPP_SENDING_ENABLED=false
# Token de acesso da Graph API (o temporário vale 24 h; para mais tempo, use um System User).
WHATSAPP_ACCESS_TOKEN=
# Versão da Graph API usada no envio; confira a vigente no painel da Meta.
WHATSAPP_GRAPH_VERSION=v23.0

# Use "native" só atrás de um proxy confiável (túnel, balanceador); com "none" vale o IP da conexão.
FORWARD_HEADERS=none

# Senha do painel do dono (/painel.html). Vazia = painel desligado.
PAINEL_SENHA=
# Número do dono para receber aviso de cada horário novo (com DDI e DDD). Vazio = sem aviso.
PAINEL_AVISO_WHATSAPP=
